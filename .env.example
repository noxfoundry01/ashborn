# Supabase project URL and publishable key. Apply supabase/migrations first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; required for protected API mutations and scheduled world ticks.
SUPABASE_SERVICE_ROLE_KEY=
WORLD_TICK_SECRET=
# Vercel Cron automatically sends this as Authorization: Bearer <CRON_SECRET>.
# Use a different random value from WORLD_TICK_SECRET; leave unset until a scheduler is configured.
CRON_SECRET=
WORLD_PAUSED=false
OPERATOR_USER_ID=
# Optional model runtime, disabled until configured and validated.
OPENAI_API_KEY=
ASHBORN_AGENT_MODEL=gpt-6-luna
AGENT_MODEL_ENABLED=false
# Finance is devnet-only and disabled until every field is configured.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_ASHBORN_MINT=
ASHBORN_MINT_DECIMALS=
ASHBORN_TOKENS_PER_100_CREDITS=
ASHBORN_BURN_BPS=
ASHBORN_TREASURY_TOKEN_ACCOUNT=
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
FINANCE_DEVNET_ENABLED=false
X402_DEVNET_ENABLED=false
X402_USDC_MINT=
X402_FACILITATOR_URL=
X402_PAY_TO=
X402_PRICE_USDC_BASE_UNITS=
